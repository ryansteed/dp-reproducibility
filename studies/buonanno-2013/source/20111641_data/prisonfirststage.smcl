{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/home/zhiwenz/private-research/studies/buonanno-2013/source/20111641_data/prisonfirststage.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 5 Nov 2024, 22:20:45
{txt}
{com}. use prisonertimeseries2
{txt}
{com}. /*generating quadratic trend term, a dummy variable for the post-pardon period, and interaction terms*/
. gen ymonthrelative2=ymonthrelative*ymonthrelative
{txt}
{com}. gen post=ymonthrelative>0
{txt}
{com}. gen postmonth=post*ymonthrelative
{txt}
{com}. gen postmonth2=post*ymonthrelative2
{txt}
{com}. 
. /*generating figure 1*/ 
. twoway  qfitci incrate ymonthrelative if ymonthrelative<=0, legend(off) || qfitci incrate ymonthrelative if ymonthrelative>0 ||scatter incrate ymonthrelative, xline(0) legend(off)  yscale(r(0 110)) ylabel(0(10)110)  ytitle("Monthly Incarceration Rate") xtitle("Month Relative to August 2006")
{res}{txt}
{com}. 
. 
. 
. /*generating the regression results in Table 2, Panel B and the denominators for the incapacitation effect estimates
> presented in Tables 3 and 5*/
. 
. tsset ymonthrelative
{res}
{p 0 15 2}{txt:Time variable: }{res:ymonthrelative}{txt:, }{res:{bind:-31}}{txt: to }{res:{bind:28}}{p_end}
{txt}{col 9}Delta: {res}1 unit
