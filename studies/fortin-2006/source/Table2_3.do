************;
* regressions that include interaction between time and enrollement (not shown in the paper);
************;
************;
gen tpubcol=time*lnpubcol;
gen t2pubcol=time2*lnpubcol;
gen tpricol=time*lnpricol;
gen t2pricol=time2*lnpricol;
**2SLS;
ivreg GAP (ygrsup=lnpubcol lnpricol tpubcol tpricol t2pubcol t2pricol) oldrsup lnurate
 time time2 trst* stdum* [weight=vwgt] , robust ;
**overid test;
predict res1, resid;
reg res1 lnpubcol lnpricol tpubcol tpricol t2pubcol t2pricol oldrsup lnurate
 time time2 trst* stdum*  [weight=vwgt] ;
gen chi=e(N)*e(r2);
di chi;
gen pvalo=chiprob(1,chi);
di pvalo;
drop res1 chi pvalo ;
