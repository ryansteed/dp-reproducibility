gen trst45=time*stdum45;
gen trst46=time*stdum46;
gen trst47=time*stdum47;
gen trst48=time*stdum48;
gen trst49=time*stdum49;
gen trst50=time*stdum50;
gen trst51=time*stdum51;
gen yr=year if year>=81;
tab yr, gen(yrd);
**constructing variables so that the year effects;
**add to zero, and are orthogonal to a time trend;
replace yrd8=yrd8-7*yrd2-6*yrd1;
replace yrd7=yrd7-6*yrd2-5*yrd1;
replace yrd6=yrd6-5*yrd2-4*yrd1;
replace yrd5=yrd5-4*yrd2-3*yrd1;
replace yrd4=yrd4-3*yrd2-2*yrd1;
replace yrd3=yrd3-2*yrd2-1*yrd1;
drop yrd2;
drop yrd1;
count;
***********;
* regressions for Table 2 by column order ;
***********;
**Table 2, column 1;
eststo:reg GAP ygrsup oldrsup lnurate time stdum* [weight=vwgt] , robust ;
**Table 2, column 2;
eststo: reg GAP ygrsup oldrsup lnurate time yrd* stdum* [weight=vwgt] , robust ;
**Table 2, column 3;
eststo owncorsup: reg GAP ygrsup oldrsup lnurate time time2 stdum* [weight=vwgt] , robust ;
**Table 2, column 4;
eststo: reg GAP ygrsup oldrsup lnurate time yrd* stdum* trst* [weight=vwgt] , robust ;
**Table 2, column 5;
eststo: reg GAP ygrsup oldrsup lnurate time time2 stdum* trst* [weight=vwgt] , robust ;
**Table 2, column 6;
eststo: reg GAP time time2 stdum*  [weight=vwgt] , robust ;
**********;
*regressions for Table 3 by column order;
***********;
**Table 3, column 1;
**2SLS;
ivreg GAP (ygrsup=lnpubcol lnpricol)  oldrsup lnurate time stdum* [weight=vwgt] , robust ;
**overid test;
predict res1, resid;
reg res1 lnpubcol lnpricol oldrsup lnurate time stdum*  [weight=vwgt] ;
gen chi=e(N)*e(r2);
di chi;
gen pvalo=chiprob(1,chi);
di pvalo;
drop res1 chi pvalo ;
* 1st stage;
reg ygrsup lnpubcol lnpricol oldrsup lnurate time stdum*   [weight=vwgt] ;
* F-test;
test lnpubcol lnpricol;
