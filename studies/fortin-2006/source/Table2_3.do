reg ygrsup lnpubcol lnpricol tpubcol tpricol t2pubcol t2pricol oldrsup lnurate
 time time2 trst* stdum*   [weight=vwgt] ;
* F-test;
test lnpubcol lnpricol tpubcol tpricol t2pubcol t2pricol;
