#delimit ;
set more off;
set matsize 800;
set mem 500m;
use edyrly;
** data in $2000 constant dollars;
** EDITED by Ryan Steed;
sort stnum year;

by stnum: gen time=_n;
tab stnum, gen(stdum);
sort stnum year;
gen yr=year if year>=73;
tab yr, gen(yrd);
**constructing variables so that the year effects;
**add to zero, and are orthogonal to a time trend;
replace yrd24=yrd24-23*yrd2-22*yrd1;
replace yrd23=yrd23-22*yrd2-21*yrd1;
replace yrd22=yrd22-21*yrd2-20*yrd1;
replace yrd21=yrd21-20*yrd2-19*yrd1;
