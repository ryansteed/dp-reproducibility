capture log closelog using figure1_aej, replace text// Project: Voting Paper// Task: create firgure 1// Author and Date: Mel Stephens, 2012-11-14version 12.1clear allmacro drop _allset matsize 2000set more offuse data/voting_paper_extract_public.dta, clearxtset fips year// Use one observation per yearegen oneperyear = tag(year)keep if oneperyear==1&year>=1969&year<=1999tab oneperyear// Generate variables to graphgen roilprice = oilprice*(168.8/cpi)gen rgasprice = gasprice*(168.8/cpi)gen rcoalprice = coalprice*(168.8/cpi)sort year/* Figure 1 - Panel A */#delimit ;twoway scatter roilprice rcoalprice year, lp(l _) msymbol(t X) c(l l) || 	scatter rgasprice year, yaxis(2) lp(-) msymbol(o) c(l) ||,	legend(label(1 "Oil") label(2 "Coal") label(3 "Natural Gas") rows(1)) 	ytitle("Oil in 2000$", axis(1)) ytitle("Gas in 2000$", axis(2))	xtitle("Year") xlabel(1970(5)2000)	title("A. Real Price of Oil, Coal, and Natural Gas")	graphregion(ifcolor(white)) graphregion(fcolor(white))	graphregion(ilcolor(white)) graphregion(lcolor(white))	saving(fig1a, replace)	;/* Export graph as Postscript file */graph export "fig1a.ps", replace;/* Figure 1 - Panel B */replace ognatlnumemp = ognatlnumemp/1000;replace coalnatlnumemp = coalnatlnumemp/1000;twoway scatter ognatlnumemp year, lp(l) msymbol(t) c(l) ||	scatter coalnatlnumemp year, yaxis(2) lp(_) msymbol(X) c(l) ||, 	legend(label(1 "Oil/Gas") label(2 "Coal") rows(1))	ytitle("Oil/Gas Employment (1000s)", axis(1)) ytitle("Coal Employment (1000s)", axis(2))	xtitle("Year") xlabel(1970(5)2000)	title("B. National Employment in Oil/Gas and Coal")	graphregion(ifcolor(white)) graphregion(fcolor(white))	graphregion(ilcolor(white)) graphregion(lcolor(white))	saving(fig1b, replace)	;/* Export graph as Postscript file */graph export "fig1b.ps", replace;#delimit crlog close