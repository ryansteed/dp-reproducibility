. ***** Appendix: Figures 1 and 2 (Data Plots) *****
. 
. use  EggerKoethenbuerger_AEJ_Data.dta.dta, clear
{txt}
{com}. sort id
{txt}
{com}. 
. gen logpop=ln(pop)
{txt}
{com}. gen logexptot=ln(exptot)
{txt}
{com}. gen exppc=exptot/pop
{txt}
{com}. gen logexppc=ln(exppc)
{txt}
{com}. graph twoway scatter logexptot logpop, mc(black) legend(off) ytitle( "Log expenditure") xtitle( "Log population" )  title( "Figure 1 - Log expenditure and log population") scheme(s1color) saving( fig_logexptot_logpop.gph, replace)
{res}{txt}file {bf:fig_logexptot_logpop.gph} saved

{com}. graph twoway scatter logexppc logpop, mc(black) legend(off) ytitle( "Log per-capita expenditure") xtitle( "Log population" ) title( "Figure 2 - Log per-capita expenditure and log population") scheme(s1color) saving( fig_logexppc_logpop.gph, replace)
{res}{txt}file {bf:fig_logexppc_logpop.gph} saved

{com}. 
