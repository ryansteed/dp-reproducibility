. di as red "All" " " "window=`w'" " " "placebo threshold=-0.0`tt'
{txt} 30{com}. reg lexptot rightm`tt' lwpop lwpop_2 lwpop_3 lwpop_r1m`tt' lwpop_r2m`tt' lwpop_r3m`tt', robust
{txt} 31{com}. test lwpop lwpop_r1m`tt' lwpop_2 lwpop_r2m`tt' lwpop_3 lwpop_r3m`tt'
