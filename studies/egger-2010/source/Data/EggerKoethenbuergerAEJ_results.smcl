. 
. foreach w in 20 {c -(}
{txt}  2{com}. use  window`w'_thresh1000_TALL_wpopdem.dta, replace
{txt}  3{com}. gen thresh=1000
{txt}  4{com}. foreach t in 2000 3000 5000 10000 20000 30000 50000 100000 200000 {c -(}
{txt}  5{com}. append using  window`w'_thresh`t'_TALL_wpopdem.dta
{txt}  6{com}. replace thresh=`t' if thresh==.
{txt}  7{com}. {c )-}
{txt}  8{com}. 
. gen lwpop_2=lwpop^2
{txt}  9{com}. gen lwpop_3=lwpop^3
{txt} 10{com}. sum lwpop
{txt} 11{com}. 
. foreach tt in 35 6 {c -(}
{txt} 12{com}. gen right`tt'=lwpop>0.0`tt'
{txt} 13{com}. gen lwpop_r1`tt'=lwpop*right`tt'
{txt} 14{com}. gen lwpop_r2`tt'=lwpop_2*right`tt'
{txt} 15{com}. gen lwpop_r3`tt'=lwpop_3*right`tt'
{txt} 16{com}. tab right`tt'
{txt} 17{com}. table right`tt', c(m rcsize) row
{txt} 18{com}. 
. di as red "All" " " "window=`w'" " " "placebo threshold=0.0`tt'
{txt} 19{com}. reg lexptot right`tt' lwpop lwpop_2 lwpop_3 lwpop_r1`tt' lwpop_r2`tt' lwpop_r3`tt', robust
{txt} 20{com}. test lwpop lwpop_r1`tt' lwpop_2 lwpop_r2`tt' lwpop_3 lwpop_r3`tt'
{txt} 21{com}. test lwpop_2 lwpop_r2`tt' lwpop_3 lwpop_r3`tt'
{txt} 22{com}. test lwpop_3 lwpop_r3`tt'
{txt} 23{com}. 
. gen rightm`tt'=lwpop>-0.0`tt'
{txt} 24{com}. gen lwpop_r1m`tt'=lwpop*rightm`tt'
{txt} 25{com}. gen lwpop_r2m`tt'=lwpop_2*rightm`tt'
{txt} 26{com}. gen lwpop_r3m`tt'=lwpop_3*rightm`tt'
{txt} 27{com}. tab rightm`tt'
{txt} 28{com}. table rightm`tt', c(m rcsize) row
